# ──────────────────────────────────────────────────────────────
# AI Notes — переменные окружения
# Скопируйте этот файл в .env.local и подставьте свои значения.
# ──────────────────────────────────────────────────────────────

# Supabase — берётся в Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Claude (Anthropic) — берётся на console.anthropic.com
# ВАЖНО: используется только на сервере (route handlers), в браузер не попадает.
ANTHROPIC_API_KEY=sk-ant-...

# Модель Claude для генерации (поиск-сводка, рерайт, сокращение)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Публичный URL приложения (для magic-link редиректа), напр. http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
